#!/bin/sh /etc/rc.common

START=15
USE_PROCD=1

start_service() {
	local worker=/usr/libexec/podkopchik-ax6000/ax6000-recovery.sh
	[ -d /etc/podkopchik-ax6000-trial ] || return 0
	/bin/sh "$worker" boot || logger -t pkc-ax6000-recovery 'early quarantine needs attention'
	procd_open_instance
	procd_set_param command /bin/sh "$worker" watch
	procd_set_param respawn 3600 2 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
