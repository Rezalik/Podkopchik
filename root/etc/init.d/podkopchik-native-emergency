#!/bin/sh /etc/rc.common
START=22
STOP=9
USE_PROCD=1
start_service() {
	local root=/etc/podkopchik-native-emergency
	[ -s "$root/state.json" ] && [ -s "$root/recovery.uc" ] || return 0
	[ "$(jsonfilter -q -i "$root/state.json" -e '@.mode')" != disarmed ] || return 0
	procd_open_instance main
	procd_set_param command ucode "$root/recovery.uc" watch
	procd_set_param respawn 3600 1 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
