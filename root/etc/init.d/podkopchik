#!/bin/sh /etc/rc.common

START=95
STOP=10
USE_PROCD=1

APP="podkopchik"
LIB="${PODKOPCHIK_LIB:-/usr/libexec/podkopchik}"
TMP_DIR="${PODKOPCHIK_TMP_DIR:-/tmp/podkopchik}"
CONFIG_DIR="${PODKOPCHIK_CONFIG_DIR:-/etc/podkopchik}"
CTL="${PODKOPCHIK_CTL:-/usr/bin/podkopchikctl}"
HEALTH="$LIB/health_check.sh"
RULES="$LIB/apply_rules.sh"
CLEANUP="$LIB/cleanup_rules.sh"
CONFIG="$CONFIG_DIR/config.json"
SAFETY="${PODKOPCHIK_SAFETY:-$LIB/routing_safety.sh}"
STARTUP_FAILED=0
STARTUP_OLD_PIDS=""

safety() { sh "$SAFETY" "$@"; }
native_present() {
	[ -s "$CONFIG_DIR/native-state/runtime.json" ] &&
		[ -n "$(jsonfilter -q -i "$CONFIG_DIR/native-state/runtime.json" -e '@.current' 2>/dev/null)" ]
}
native_runtime() { sh "$LIB/native_runtime.sh" "$@"; }
native_missing() {
	local emergency="${PKC_EMERGENCY_VM_ROOT:-/etc/podkopchik-native-emergency}/state.json"
	[ "$(jsonfilter -q -i "$emergency" -e '@.mode' 2>/dev/null)" != restored ] || return 0
	[ "$(uci -c "${PODKOPCHIK_UCI_CONFIG_DIR:-/etc/config}" -q get "$APP.main.routing_enabled" 2>/dev/null)" != 0 ] || return 1
	[ "$(uci -c "${PODKOPCHIK_UCI_CONFIG_DIR:-/etc/config}" -q get "$APP.main.routing_engine" 2>/dev/null)" = native ] || return 1
	if native_present && ucode -e 'import {lstat,readfile} from "fs";
		let root=ARGV[0]+"/native-state",s=lstat(root+"/runtime.json");if(s?.type!="file"||s.uid!=0||(s.mode&0o077))exit(1);
		let m=json(readfile(root+"/runtime.json"));if(m.schema!=1||!match(m.current || "",/^[a-f0-9]{32}$/))exit(1);
		s=lstat(root+"/g-"+m.current+"/plan.json");if(s?.type!="file"||s.uid!=0||(s.mode&0o077))exit(1);' "$CONFIG_DIR"; then return 1; fi
	sh "$LIB/native_boot_guard.sh" hold || safety guard
	logger -t podkopchik 'Native selected but generation metadata is missing; management retained, LAN/DNS guarded; explicit repair required'
	return 0
}

startup_error() {
	STARTUP_FAILED=1
	logger -t podkopchik "$1; saved routing intention unchanged"
	if ! safety guard; then
		logger -t podkopchik 'CRITICAL: routing guard unavailable; fail-closed cannot be guaranteed'
	fi
	return 1
}

wait_ready() {
	local attempt=0
	while [ "$attempt" -lt 10 ]; do
		safety ready "${1:-}" && return 0
		sleep 1
		attempt=$((attempt + 1))
	done
	return 1
}

restore_startup() {
	safety restore &&
		ucode -L "$LIB" "$LIB/awg_cli.uc" restore-active &&
		"$CTL" validate-active >/dev/null 2>&1 || return 1
	xray_instance || return 1
	logger -t podkopchik 'startup recovered the last working Xray/nft snapshot; pending settings were not applied'
}

xray_bin() {
	. "$LIB/xray.sh"
	xray_bin
}

extra_command "core_restart" "Restart only the selected Xray instance"

xray_instance() {
	local bin="$(xray_bin)"
	[ -n "$bin" ] || return 1
	procd_open_instance xray
	procd_set_param command "$bin" run -config "$CONFIG"
	# Transparent UDP and DNS share this process, including AWG-only setups.
	procd_set_param limits nofile="16384 16384"
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

core_restart() {
	if native_missing; then return 1; fi
	if native_present; then native_runtime boot; return; fi
	local old_pids
	uci_bool "$APP.main.enabled" && uci_bool "$APP.main.routing_enabled" || return 1
	"$CTL" validate-active >/dev/null 2>&1 || return 1
	safety fake-sync || return 1
	old_pids="$(safety pids)" || return 1
	procd_kill "$APP" xray
	procd_open_service "$APP" /etc/init.d/podkopchik
	xray_instance || return 1
	if ! ubus call service list '{"name":"podkopchik"}' 2>/dev/null | jsonfilter -q -e '@.podkopchik.instances.health.running' | grep -q true; then
		health_instance
	fi
	procd_close_service add
	wait_ready "$old_pids"
}

health_instance() {
	procd_open_instance health
	procd_set_param command "$HEALTH" daemon
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

uci_bool() {
	[ "$(uci -q get "$1" 2>/dev/null)" = "1" ]
}

start_service() {
	STARTUP_FAILED=0
	if native_missing; then return 1; fi
	if native_present; then native_runtime boot; return; fi
	safety fake-sync || { startup_error 'could not establish FakeDNS quarantine'; return 1; }
	uci_bool "$APP.main.enabled" || return 0

	mkdir -p "$TMP_DIR" "$CONFIG_DIR"
	if uci_bool "$APP.main.routing_enabled"; then
		safety guard || { startup_error 'could not arm startup routing guard'; return 1; }
		STARTUP_OLD_PIDS="$(safety pids)" || return 1
		[ -z "$STARTUP_OLD_PIDS" ] || procd_kill "$APP" xray
	fi
	ucode -L "$LIB" "$LIB/awg_cli.uc" recover ||
		logger -t podkopchik "AWG transaction recovery requires attention"
	# Kernel interfaces have no per-connection daemon. Restore desired state
	# before starting Xray, without changing main/default routing.
	ucode -L "$LIB" "$LIB/awg_cli.uc" sync ||
		logger -t podkopchik "AWG restore failed; unavailable AWG targets must remain blocked"
	health_instance
	# A deliberate routing disable must survive boot; health remains available.
	uci_bool "$APP.main.routing_enabled" || return 0
	"$CTL" prepare-connections || {
		restore_startup && return 0
		startup_error 'could not prepare safe connection config; Xray startup refused'
		return 1
	}

	if [ -s "$CONFIG" ]; then
		if "$CTL" validate-active >/dev/null 2>&1; then
			startup_log="$TMP_DIR/startup-rules.err"
			umask 077
			if ! "$RULES" >"$startup_log" 2>&1; then
				# nft errors contain no links/keys. Keep only a bounded root-only tail.
				head -c 4096 "$startup_log" > "$startup_log.bounded"
				mv "$startup_log.bounded" "$startup_log"
				restore_startup && return 0
				startup_error 'failed to apply Podkopchik nftables rules; Xray startup refused; see startup-rules.err'
				return 1
			fi
			rm -f "$startup_log"
			bin="$(xray_bin)"
			if [ -n "$bin" ]; then
				xray_instance
			else
				startup_error 'xray binary not found; routing remains blocked'
				return 1
			fi
		else
			restore_startup && return 0
			startup_error 'active Xray config failed validation; keeping routing blocked'
			return 1
		fi
	else
		restore_startup && return 0
		startup_error 'active Xray config missing; keeping routing blocked'
		return 1
	fi
}

service_started() {
	if native_present; then return 0; fi
	[ "$STARTUP_FAILED" = 0 ] || return 1
	uci_bool "$APP.main.routing_enabled" || return 0
	if wait_ready "$STARTUP_OLD_PIDS" && safety save && safety unguard; then return 0; fi
	startup_error 'Xray listener or working-state checkpoint failed; routing guard retained'
}

stop_service() {
	if native_present; then native_runtime stop; return; fi
	safety fake-sync || { startup_error 'could not retain FakeDNS quarantine'; return 1; }
	if uci_bool "$APP.main.routing_enabled"; then
		# A service failure/restart is not an instruction to expose traffic.
		safety guard || logger -t podkopchik 'CRITICAL: could not guard traffic while stopping Xray'
	else
		"$CLEANUP" >/dev/null 2>&1 || true
		safety unguard || logger -t podkopchik 'could not remove routing guard after explicit disable'
	fi
	ucode -L "$LIB" "$LIB/awg_cli.uc" stop-all >/dev/null 2>&1 || true
}

reload_service() {
	# UCI commit is not runtime Apply. Keep the confirmed native generation
	# until the ordinary Apply validates and stages its replacement.
	if native_present || [ "$(uci -q get "$APP.main.routing_engine" 2>/dev/null)" = native ]; then return 0; fi
	restart
}

service_triggers() {
	procd_add_reload_trigger "$APP"
}
