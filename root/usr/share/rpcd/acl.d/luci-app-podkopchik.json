{
	"luci-app-podkopchik": {
		"description": "Grant access to Podkopchik configuration and commands",
		"read": {
			"uci": [ "podkopchik" ],
			"cgi-io": [ "exec" ],
			"file": {
				"/usr/bin/podkopchikctl status": [ "exec" ],
				"/usr/bin/podkopchikctl update-check": [ "exec" ],
				"/usr/bin/podkopchikctl xray-status": [ "exec" ],
				"/sbin/logread -e podkopchik": [ "exec" ],
				"/usr/sbin/logread -e podkopchik": [ "exec" ],
				"/tmp/podkopchik/state.json": [ "read" ],
				"/etc/podkopchik/config.json": [ "read" ]
			},
			"ubus": {
				"podkopchik.awg": [ "list" ],
				"uci": [ "get" ]
			}
		},
		"write": {
			"uci": [ "podkopchik" ],
			"cgi-io": [ "exec" ],
			"file": {
				"/usr/bin/podkopchikctl apply": [ "exec" ],
				"/usr/bin/podkopchikctl health": [ "exec" ],
				"/usr/bin/podkopchikctl restart": [ "exec" ],
				"/usr/bin/podkopchikctl cleanup": [ "exec" ],
				"/usr/bin/podkopchikctl validate": [ "exec" ],
				"/usr/bin/podkopchikctl update-install": [ "exec" ],
				"/usr/bin/podkopchikctl rollback": [ "exec" ],
				"/usr/bin/podkopchikctl xray-check package": [ "exec" ],
				"/usr/bin/podkopchikctl xray-check official": [ "exec" ],
				"/usr/bin/podkopchikctl xray-install package": [ "exec" ],
				"/usr/bin/podkopchikctl xray-install official": [ "exec" ],
				"/usr/bin/podkopchikctl xray-rollback": [ "exec" ],
				"/usr/bin/podkopchikctl xray-start-check package": [ "exec" ],
				"/usr/bin/podkopchikctl xray-start-check official": [ "exec" ],
				"/usr/bin/podkopchikctl xray-start-install package": [ "exec" ],
				"/usr/bin/podkopchikctl xray-start-install official": [ "exec" ],
				"/usr/bin/podkopchikctl xray-start-rollback": [ "exec" ],
				"/usr/bin/podkopchikctl probe-vless": [ "exec" ]
			},
			"ubus": {
				"podkopchik.awg": [ "import", "replace", "validate", "rename", "delete", "start", "stop", "restart", "check", "assign", "recover", "set_interception", "set_probe" ],
				"file": [ "exec" ],
				"uci": [ "add", "apply", "delete", "set" ]
			}
		}
	}
}
